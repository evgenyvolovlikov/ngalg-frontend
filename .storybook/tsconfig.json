{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler"
  },
  "exclude": ["../src/test.ts", "../src/**/*.spec.ts"],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.stories.*",
    "./preview.ts",
    "main.ts",
    "typings.d.ts",
    "../eslint.config.ts"
  ],
  "files": ["./typings.d.ts"]
}
