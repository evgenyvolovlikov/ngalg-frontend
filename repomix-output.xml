    type: 'COMPLEXITY';
    data: ComplexityBlockData;
}
export interface FeaturesBlock {
    type: 'FEATURES';
    data: FeaturesBlockData;
}

export type ArticleContentBlock =
    TextBlock | NoteBlock | CodeBlock | ImageBlock | ComplexityBlock | FeaturesBlock;

