{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve",
    "build:prod": "ng build",
    "watch:dev": "ng build --watch --configuration development",
    "lint": "pnpm lint:ts && pnpm lint:styles",
    "lint:ts": "ng lint",
    "lint:ts:fix": "ng lint --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "repomix": "npx repomix",
    "storybook": "ng run client:storybook",
    "build-storybook": "ng run client:build-storybook"
  },
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular-eslint/builder": "22.1.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@chromatic-com/storybook": "latest",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@compodoc/compodoc": "latest",
    "@conarti/eslint-plugin-feature-sliced": "^1.0.5",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/angular": "^10.5.10",
    "@storybook/angular-vite": "^10.5.10",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vite": "latest",
    "vitest": "latest"
  }
}
