<file path="src/shared/ui/input/input.component.html">
<div class="app-input" [class.app-input--disabled]="isDisabled()" [class.app-input--error]="hasError || errorMessage()">
  @if (label()) {
    <label class="app-input__label" [for]="id()">
      {{ label() }}
      @if (isRequired) {
        <span class="app-input__required-mark" aria-hidden="true">*</span>
      }
    </label>
  }

  <div class="app-input__wrapper">
    <input
      [id]="id()"
      class="app-input__field"
      [type]="inputType()"
      [value]="value()"
      [placeholder]="placeholder()"
      [disabled]="isDisabled()"
      [readOnly]="readonly()"
      [attr.aria-required]="isRequired"
      [attr.aria-invalid]="hasError || !!errorMessage()"
      [attr.aria-describedby]="errorText ? id() + '-error' : null"
      (input)="onInput($event)"
      (blur)="onBlur()"
    />

    @if (type() === "password") {
      <button
        type="button"
        class="app-input__toggle-password"
        (click)="togglePasswordVisibility($event)"
        [disabled]="isDisabled()"
        [attr.aria-label]="isPasswordVisible() ? 'Скрыть пароль' : 'Показать пароль'"
      >
        <span class="icon">
          @if (isPasswordVisible()) {
            <app-icon [name]="'eye-opened'" [description]="'eye-opened'" size="m"> </app-icon>
          } @else {
            <app-icon [name]="'eye-closed'" [description]="'eye-closed'" size="m"> </app-icon>
          }
        </span>
      </button>
    }
  </div>

  @if (errorText) {
    <span class="app-input__error" [id]="id() + '-error'">
      {{ errorText }}
    </span>
  }
</div>
</file>

<file path="src/shared/ui/input/input.component.scss">
:host {
    display: block;
    width: 100%;
}

.app-input {
    display: flex;
    flex-direction: column;
    gap: var(--unit-1);
    width: 100%;

    &__label {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-medium);
        color: var(--text-muted);
        cursor: pointer;
    }

    &__required-mark {
        margin-left: var(--unit-1);
        color: var(--color-error);
    }

    &__wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    &__field {
        width: 100%;
        height: var(--unit-10);
        padding: 0 var(--unit-3);
        background-color: var(--background-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        font-family: var(--font-family-sans);
        font-size: var(--font-size-sm);
        color: var(--text-color);
        transition:
            border-color var(--transition-fast),
            background-color var(--transition-fast);

        &::placeholder {
            color: var(--text-disabled);
        }

        &:focus {
            outline: none;
        }

        &:focus-visible {
            border-color: transparent;
            outline: 2px solid var(--border-focus);
            outline-offset: -1px;
        }
    }

    &__toggle-password {
        position: absolute;
        right: var(--unit-3);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;

        &:hover {
            color: var(--text-color);
        }
    }

    &__error {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-medium);
        color: var(--color-error);
    }

    &--sm {
        .app-input__label {
            font-size: var(--font-size-xs);
        }

        .app-input__field {
            height: var(--unit-8);
            padding: 0 var(--unit-2);
            font-size: var(--font-size-xs);
        }
    }

    &--lg {
        .app-input__label {
            font-size: var(--font-size-base);
        }

        .app-input__field {
            height: var(--unit-12);
            padding: 0 var(--unit-4);
            font-size: var(--font-size-base);
        }
    }

    &--error {
        .app-input__field {
            border-color: var(--color-error);

            &:focus-visible {
                outline-color: var(--color-error);
            }
        }
    }

    &--disabled {
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;

        .app-input__label,
        .app-input__field,
        .app-input__toggle-password {
            cursor: not-allowed;
        }

        .app-input__field {
            background-color: var(--bg-surface);
        }
    }

    .icon {
        display: flex;
    }
}
</file>

<file path="src/widgets/header/ui/header.component.scss">
:host {
    display: block;

    --max-width: 1440px;
}

.header {
    position: relative;
    z-index: var(--z-fixed);
    width: 100%;
    background-color: var(--background-color);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(8px);

    &__container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: var(--max-width);
        height: var(--unit-16);
        margin: 0 auto;
        padding: 0 var(--unit-8);
    }

    &__logo {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        color: var(--text-color);
        letter-spacing: -0.5px;
    }

    &__nav-wrapper {
        display: flex;
        gap: var(--unit-8);
        align-items: center;
    }

    &__menu {
        display: flex;
        gap: var(--unit-6);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    &__link {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-medium);
        color: var(--text-color);

        &:hover {
            opacity: var(--opacity-hover);
        }
    }

    &__nav-actions {
        display: flex;
        gap: var(--unit-3);
        align-items: center;

        .profile-badge {
            display: flex;
            gap: var(--unit-2, 8px);
            align-items: center;
            padding: var(--unit-1, 4px) var(--unit-3, 12px);
            background-color: var(--bg-surface-hover, #f3f4f6);
            border: 1px solid var(--border-color, #e5e7eb);
            border-radius: var(--radius-md, 8px);
            color: var(--text-color, #111827);
            transition: background-color 0.2s ease;
            text-decoration: none;

            &:hover {
                background-color: var(--bg-surface, #e5e7eb);
            }

            &__email {
                max-width: 150px;
                font-size: var(--font-size-sm, 14px);
                font-weight: var(--font-weight-medium, 500);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        }
    }

    &__burger {
        display: none;
    }

    &__overlay {
        display: none;
    }
}

@media (width <= 768px) {
    .header {
        &__overlay {
            position: fixed;
            z-index: 90;
            display: block;
            width: 100%;
            height: 100%;
            padding: 0;
            background-color: rgb(0 0 0 / 50%);
            border: none;
            cursor: pointer;
            inset: 0;
            backdrop-filter: blur(2px);
        }

        &__burger {
            position: relative;
            z-index: 110;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 24px;
            height: 24px;
            padding: 0;
            background: transparent;
            border: none;
            cursor: pointer;

            span,
            &::before,
            &::after {
                position: absolute;
                width: 100%;
                height: 2px;
                background-color: var(--text-color);
                border-radius: 1px;
                transition:
                    transform var(--transition-fast),
                    opacity var(--transition-fast);
                content: '';
            }

            &::before {
                transform: translateY(-7px);
            }

            &::after {
                transform: translateY(7px);
            }

            &--active {
                span {
                    opacity: 0;
                }

                &::before {
                    transform: translateY(0) rotate(45deg);
                }

                &::after {
                    transform: translateY(0) rotate(-45deg);
                }
            }
        }

        &__nav {
            position: fixed;
            top: 0;
            right: 0;
            z-index: 100;
            width: 80%;
            max-width: 300px;
            height: 100dvh; /* Использование dvh вместо vh */
            padding: var(--unit-20) var(--unit-6) var(--unit-6);
            background-color: var(--background-color);
            transition: transform var(--transition-base);
            border-left: 1px solid var(--border-color);
            transform: translateX(100%); /* Видеокарта задействована */

            &--open {
                transform: translateX(0);
            }
        }

        &__nav-wrapper {
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-start;
            width: 100%;
            height: 100%;
        }

        &__menu {
            flex-direction: column;
            gap: var(--unit-4);
            width: 100%;
            padding-top: var(--unit-16);
            padding-left: var(--unit-4);
        }

        &__link {
            font-size: var(--font-size-lg);
        }

        &__nav-actions {
            justify-content: space-between;
            width: 100%;
            padding: var(--unit-4);
            border-top: 1px solid var(--border-color);
        }
    }
}
</file>

